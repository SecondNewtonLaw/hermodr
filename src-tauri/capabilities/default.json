{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the local chrome UI webview",
  "webviews": ["ui"],
  "permissions": [
    "core:default",
    "allow-list-tabs",
    "allow-add-tab",
    "allow-select-tab",
    "allow-close-tab",
    "allow-rename-tab",
    "allow-reorder-tabs",
    "allow-set-zoom",
    "allow-zoom-by",
    "allow-reset-zoom",
    "allow-get-settings",
    "allow-set-settings",
    "allow-open-settings"
  ]
}
